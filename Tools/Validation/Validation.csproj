<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputType Condition="'$(ModuleName)' == ''">Exe</OutputType>
    <AssemblyName Condition="'$(ModuleName)' == ''">SelfTest</AssemblyName>
    <AssemblyName Condition="'$(ModuleName)' != ''">$(ModuleName)</AssemblyName>
    <IntermediateOutputPath>obj/$(AssemblyName)/</IntermediateOutputPath>
    <OutputPath>bin/$(AssemblyName)/</OutputPath>
  </PropertyGroup>
  <Target Name="CheckHostPaths" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(OmniPath)/OmniToolbox.Common.dll')" Text="Set OmniPath to the current Omni plugin directory." />
    <Error Condition="!Exists('$(DalamudPath)/Dalamud.dll')" Text="Set DalamudPath to the current Dalamud Hooks directory." />
  </Target>
  <ItemGroup>
    <Compile Include="../../Modules/$(ModuleName).cs" Condition="'$(ModuleName)' != ''" />
    <Compile Include="../../Modules/*.cs;Program.cs;Checks.cs;CommandProxy.cs" Condition="'$(ModuleName)' == ''" />
    <Reference Include="$(OmniPath)/*.dll" />
    <Reference Include="$(DalamudPath)/Dalamud.dll" />
    <Reference Include="$(DalamudPath)/Dalamud.Common.dll" />
    <Reference Include="$(DalamudPath)/Dalamud.Bindings.ImGui.dll" />
    <Reference Include="$(DalamudPath)/Dalamud.Bindings.ImPlot.dll" />
    <Reference Include="$(DalamudPath)/Lumina.dll" />
    <Reference Include="$(DalamudPath)/Lumina.Excel.dll" />
    <Reference Include="$(DalamudPath)/FFXIVClientStructs.dll" />
    <Reference Include="$(DalamudPath)/InteropGenerator.Runtime.dll" />
    <Reference Include="$(DalamudPath)/Newtonsoft.Json.dll" />
    <Reference Include="$(DalamudPath)/Serilog.dll" />
  </ItemGroup>
</Project>
